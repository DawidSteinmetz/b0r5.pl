# Kopie zapasowe tylko na tym komputerze
/_kopia*/

# Muzyka radia i dane aktualnie działających instalacji
/_/radio/
**/_logika/stan/*
!**/_logika/stan/.keep
**/_dane/*
!**/_dane/.htaccess

# Sekretne wiadomości i rynek pomiędzy postaciami
/_/gabinet/_logika/poczta_odbior.json
/__/buduar/_logika/poczta.json
/_/piwnica/_logika/rynek.json

# Dane gry i poświadczenia — pozostają na serwerze
/api/dane/*
!/api/dane/.htaccess
/api/konfiguracja-bazy.php

# Importy SQL w archiwum nie są źródłem wdrożeniowym
/archiwum/sql/*.sql

# Pliki lokalne
node_modules/
__pycache__/
.DS_Store
Thumbs.db
desktop.ini

# Dźwięki (duże, licencja zewnętrzna) — wgrywane ręcznie na serwer
/sound/*.mp3
