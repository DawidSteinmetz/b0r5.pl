# Dodatkowa blokada katalogu danych (główna ochrona jest w samych plikach).
RedirectMatch 404 /api/dane/
<FilesMatch "^konfiguracja-(bazy|ai)\.php$">
  Require all denied
</FilesMatch>
# Skrypty SQL nie są zasobem publicznym (schemat, migracje, dane startowe mapy).
<FilesMatch "\.sql$">
  Require all denied
</FilesMatch>
